{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build with Cygwin",
            "type": "shell",
            "command": "D:\\Cygwin\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always"
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}